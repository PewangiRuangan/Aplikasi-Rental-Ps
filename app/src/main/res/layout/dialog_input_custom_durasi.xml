<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogCustomDurasiLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/textJudulInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masukkan Durasi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editTextDurasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan angka"
        android:inputType="number"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:textColor="#000000"
        android:textColorHint="#888888"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/spinnerSatuanDurasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:drawable/btn_dropdown"
        android:popupBackground="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnKonfirmasiDurasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Konfirmasi"
        android:background="?attr/selectableItemBackground"
        android:textColor="#6200EE"
        android:padding="12dp" />
</LinearLayout>
