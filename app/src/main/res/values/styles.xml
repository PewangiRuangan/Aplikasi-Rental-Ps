<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema utama aplikasi -->
    <style name="Theme.RentalPS" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Warna utama -->

        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Komponen Material -->
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialButtonOutlinedStyle">@style/BlueButtonOutlined</item>

        <!-- Transisi & animasi -->
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Dialog</item>
    </style>

    <!-- Animasi dialog -->
    <style name="Animation.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Style dialog custom -->
    <style name="CustomDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:background">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
    </style>

    <!-- Style AlertDialog -->
    <style name="CustomAlertDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@drawable/dialog_background</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Style Card yang bisa dipilih -->
    <style name="SelectableCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="SelectableCardSmall" parent="SelectableCard">
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- Text di dalam opsi durasi/harga -->
    <style name="TextOption">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Card harga di dalam GridLayout -->
    <style name="CardHargaStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_default</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="TextHargaStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Tombol pilihan -->
    <style name="ChoiceButton">
        <item name="android:layout_margin">4dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/purple_200</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- Tombol untuk durasi dan harga -->
    <style name="KonsolButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/card_default</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DurasiHargaButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/card_default</item> <!-- default background -->
    </style>



    <!-- Tombol outline biru -->
    <style name="BlueButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/orange</item>
        <item name="android:textColor">@color/blue_custom</item>
    </style>

    <!-- Tombol konfirmasi -->
    <style name="ConfirmButton">
        <item name="android:backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Style input EditText -->
    <style name="CustomEditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#2C2C2C</item>
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>
